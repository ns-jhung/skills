# syntax = docker/dockerfile:experimental
FROM artifactory-rd.netskope.io/org-base-docker/cloud-python3-2004:25.86.204
ARG PyPiVersion

ARG HomeDir

MAINTAINER Birajendu Sahu <birajendu@netskope.com>

RUN apt-get update && \
    apt-get install -y --allow-unauthenticated \
    sudo

RUN /usr/sbin/usermod -aG sudo nsadmin


RUN apt-get update && apt-get -y install libssl-dev libffi-dev gcc g++ python3.8-dev mariadb-client-core-10.4
# Install requirements for dyncleanup
RUN --mount=type=bind,target=/src_tree \
        pip install --no-deps -r /src_tree/requirements.txt
RUN --mount=type=bind,target=/src_tree pip install /src_tree/dist/nsdyncleanup-${PyPiVersion}.tar.gz
